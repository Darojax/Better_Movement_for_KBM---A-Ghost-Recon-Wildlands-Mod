<Window x:Class="GRWBetterMovementLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Better Movement for KBM — Ghost Recon Wildlands"
        Icon="Assets/grw.ico"
        Width="1106" Height="800" MinWidth="1106" MinHeight="760"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CheckCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBackground" Property="Background" Value="#303830" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBackground" Property="Background" Value="#414B41" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="#313B31" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="31" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="LauncherTitleBar" Grid.Row="0" Background="#111510" MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/grw.ico" Width="16" Height="16" Margin="10,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Better Movement for KBM — Ghost Recon Wildlands" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <Button Grid.Column="2" Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"
                            ToolTip="Minimize" AutomationProperties.Name="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextBrush}" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextBrush}" />
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="LauncherBody" Grid.Row="1" Background="{StaticResource WindowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="30,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="GHOST RECON WILDLANDS" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="BETTER MOVEMENT FOR KBM" FontSize="28" FontWeight="Light" />
                        <TextBlock Text="by Codex &amp; Darojax" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="10,0,0,4" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#202820" BorderBrush="#445044" BorderThickness="1" CornerRadius="5" Padding="16,12" Margin="0,18,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Background="{Binding SummaryBrush}" CornerRadius="2" Margin="0,1,14,1" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="ShowCautionPanelButton_Click"
                            Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" VerticalAlignment="Center"
                            ToolTip="Please read the safety and account-risk information before using the mod">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource WarningBrush}" Margin="0,0,8,0">
                                <TextBlock Text="!" Foreground="#111510" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Risks &amp; Safety" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SAFETY &amp; COMPATIBILITY" Style="{StaticResource MetaLabel}" />
                    <TextBlock Text="  ·  LIVE" Foreground="{StaticResource ReadyBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding LastChecked, StringFormat=  ·  Updated {0}}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="3,0,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CheckCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="31" Height="31" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Width="27" Height="27" CornerRadius="14" Background="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusGlyph}" Foreground="#111510" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Ready">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform X="-1" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Caution">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-1" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Blocked">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-2" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Ellipse Width="31" Height="31" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                 StrokeDashArray="2,2" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:2.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding DetailToolTip}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <Button Grid.Column="3" Content="{Binding ActionLabel}" Command="{Binding DataContext.CheckActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinWidth="74" Height="34" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanExecuteAction}"
                                            Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Disable in running game" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButton}"
                        ToolTip="Disables the mod while the game is running" />
                <Button Grid.Column="2" Content="Enable in running game" Command="{Binding AttachCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        ToolTip="Enables the mod while the game is running" />
                <Button Grid.Column="3" Content="Launch without mod" Command="{Binding LaunchVanillaCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                        ToolTip="Launches the game normally without introducing the mod" />
                <Button Grid.Column="4" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" MinWidth="244" Margin="10,0,0,0">
                    <TextBlock Text="Launch with Better Movement for KBM" Foreground="#12160F" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Background="#171C17">
            <Grid.RowDefinitions>
                <RowDefinition Height="245" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ClipToBounds="True">
                <Image Source="Assets/nomad_1.png" Stretch="UniformToFill" Opacity="0.70" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00171C17" Offset="0.3" />
                            <GradientStop Color="#FF171C17" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Border Background="#D9B7C96D" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                    <TextBlock Text="LIVE" Foreground="#111510" FontWeight="Bold" FontSize="10" />
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,0,20,16">
                <TextBlock Text="INSTALLATION" Style="{StaticResource MetaLabel}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Storefront}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GamePath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="CURRENT ACTIVITY" Style="{StaticResource MetaLabel}" Margin="0,0,0,7" />
                    <TextBlock Text="{Binding Activity}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="20,15,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="ACTIVITY LOG" Style="{StaticResource MetaLabel}" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" HorizontalAlignment="Right" FontSize="10" />
                </Grid>
                <ScrollViewer x:Name="ActivityLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ScrollViewer.Resources>
                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="10" />
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding ActivityLog}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,4,7" IsHitTestVisible="False" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="4" Text="Offline single-player use only" Foreground="#677064" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,16" />
        </Grid>
            </Grid>

            <Grid x:Name="AntiCheatOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="760" Height="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SAYNOTOEAC MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Required before Better Movement for KBM can be used" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="SayNoToEAC is a third-party mod by SunBeam. Better Movement for KBM does not bundle or install it."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1A201A" BorderBrush="{StaticResource BlockedBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,17,0,16" x:Name="AntiCheatStatusBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BlockedBrush}"
                                        VerticalAlignment="Center" x:Name="AntiCheatStatusCircle">
                                    <TextBlock x:Name="AntiCheatStatusGlyph" Text="×" Foreground="#111510" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="AntiCheatStatusHeading" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="AntiCheatStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="INSTALLATION INSTRUCTIONS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

                            <TextBlock Text="1. Fully exit Ghost Recon Wildlands before changing any Easy Anti-Cheat files."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />

                            <TextBlock Text="2. Download SayNoToEAC from the original author thread or the alternative GamePressure mirror:"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <StackPanel Margin="18,7,0,0">
                                <TextBlock FontSize="12">
                                    <Hyperlink NavigateUri="https://fearlessrevolution.com/viewtopic.php?t=5980" RequestNavigate="AntiCheatLink_RequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">Original author thread — Fearless Revolution</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,6,0,0">
                                    <Hyperlink NavigateUri="https://www.gamepressure.com/download/tom-clancys-ghost-recon-wildlands-saynotoeac-mod/z113c5e"
                                               RequestNavigate="AntiCheatLink_RequestNavigate" Foreground="{StaticResource AccentBrush}">Alternative download mirror — GamePressure</Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="3. In the selected game's EasyAntiCheat folder, rename EasyAntiCheat_x86.dll and EasyAntiCheat_x64.dll by adding .BAK to each filename."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />
                            <Button Content="Open EasyAntiCheat folder" Click="OpenAntiCheatFolderButton_Click" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="18,8,0,0" />

                            <TextBlock Text="4. Extract the two replacement DLLs from the downloaded archive into that EasyAntiCheat folder."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />
                            <Border Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="5" Padding="14,11" Margin="18,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource WarningBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="!" Foreground="#111510" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Keep the .BAK files so you may restore the original Ubisoft DLLs without having to validate the entire game installation."
                                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="5. Close this panel. The 'Anti-cheat configuration' check in the main window should turn green automatically."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />
                        </StackPanel>

                        <Button Grid.Row="3" Click="CloseAntiCheatPanelButton_Click" Style="{StaticResource PrimaryButton}"
                                MinWidth="92" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <TextBlock Text="Close" Foreground="#12160F" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SaveBackupOverlay" Grid.RowSpan="2" Panel.ZIndex="105" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="760" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SAVE BACKUP MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="SavePanelHeading" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="The default Ubisoft save location is detected automatically. Add redirected or custom save locations below; every source keeps an independent backup identity and history."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="13,9" Margin="0,16,0,14">
                            <TextBlock Text="Exit Ghost Recon Wildlands before creating a backup. The launcher never combines, restores, or copies saves between sources automatically."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <ListBox x:Name="SaveLocationsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="SaveLocationsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#192019" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="12,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#232C23" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="  ·  Automatic" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                                           VerticalAlignment="Center" Visibility="{Binding IsAutomatic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,10,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SavePanelStatus" Grid.Row="3" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Grid x:Name="SavePanelActions" Grid.Row="4" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Add custom location…" Click="AddSaveLocationButton_Click" Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="RemoveSaveLocationButton" Grid.Column="1" Content="Remove selected" Click="RemoveSaveLocationButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" IsEnabled="False" />
                            <Button x:Name="BackUpAllSaveLocationsButton" Grid.Column="3" Content="Back up all" Click="BackUpAllSaveLocationsButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" />
                            <Button Grid.Column="4" Click="CloseSavePanelButton_Click" Style="{StaticResource PrimaryButton}"
                                    MinWidth="92" Margin="9,0,0,0">
                                <TextBlock Text="Close" Foreground="#12160F" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CautionOverlay" Grid.RowSpan="2" Panel.ZIndex="110" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="680" Height="684" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="WHAT DOES THIS MOD DO?" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="The mod installs a mouse hook that consumes mouse-wheel events. Scrolling the mouse wheel while moving adjusts the character's movement speed granularly, which was previously only possible with an analogue controller. (Mouse scroll wheel to cycle weapon slots is disabled.) The mod also adjusts Aim-Down-Sight movement speeds so they stay more in line with non-Aim-Down-Sight movement speeds."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,17,0,17">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource WarningBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="!" Foreground="#111510" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Ubisoft or its anti-cheat systems may treat memory modifications performed by this mod as prohibited activity. Possible consequences include detection, crashes, corrupted saves, account suspension, or a permanent account ban. No launcher check, firewall rule, offline procedure, or anti-cheat replacement can guarantee account safety."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="REGARDING CAUTIONS" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                            <TextBlock Text="Better Movement for KBM is an unofficial mod that changes the running Ghost Recon Wildlands process. Offline precautions can reduce exposure, but they cannot make process modification risk-free."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,13" />
                            <TextBlock Text="Your responsibility" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Use the mod only in offline single-player, never in co-op or Ghost War. Review each caution before proceeding and accept that enforcement and data-loss risk remain yours."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,13" />

                            <TextBlock Text="Network isolation" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Firewall isolation is optional, but helps keep an offline single-player modding session from communicating through Ghost Recon Wildlands or Ubisoft Connect. It cannot guarantee account safety."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,13" />

                            <TextBlock Text="Save backup" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="A current, edition-specific backup provides a recovery point if a save is damaged, replaced, or synchronized unexpectedly. Steam and Ubisoft Connect progress may be stored separately."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,13" />

                            <TextBlock Text="Game compatibility" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="An untested executable may still work because the runtime verifies every required instruction before writing. A caution means compatibility is not established—not that verification has been bypassed."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,13" />

                            <TextBlock Text="Red blocked items are different: they prevent the movement runtime from attaching. Green items have passed the launcher's current check."
                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Disclaimer: Better Movement for KBM is used entirely at your own risk. Codex and Darojax accept no responsibility for account sanctions, loss of access, corrupted or lost data, crashes, or any other consequences arising from its use."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,22,0" />
                            <Button Grid.Column="1" Click="CloseCautionPanelButton_Click" Style="{StaticResource PrimaryButton}"
                                    MinWidth="92" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="Close" Foreground="#12160F" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
