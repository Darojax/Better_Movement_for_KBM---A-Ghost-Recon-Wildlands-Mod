<Window x:Class="GRWBetterMovementLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Better Movement for KBM - GRW"
        Icon="Assets/grw.ico"
        Width="1106" Height="784" MinWidth="1106" MinHeight="744"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        PreviewMouseLeftButtonDown="MainWindow_PreviewMouseLeftButtonDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CheckCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBackground" Property="Background" Value="#303830" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBackground" Property="Background" Value="#414B41" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C85F59" />
            <Setter Property="Foreground" Value="#170B0A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#DD746D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder" Property="Background" Value="#A94843" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="#313B31" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="LauncherTitleBar" Grid.Row="0" Visibility="Collapsed" />

            <Grid x:Name="LauncherBody" Grid.Row="1" Background="{StaticResource WindowBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,21,24,0">
                <StackPanel>
                    <TextBlock Text="GHOST RECON WILDLANDS" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Image Source="Assets/better_movement_for_kbm_logo_small_and_trimmed.png" Width="301" Height="49"
                               Stretch="Uniform" VerticalAlignment="Bottom" />
                        <TextBlock Text="by Codex &amp; Darojax" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="10,0,0,6" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#202820" BorderBrush="#445044" BorderThickness="1" CornerRadius="5" Padding="16,12" Margin="30,18,24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="5" Background="{Binding SummaryBrush}" CornerRadius="2" Margin="0,1,14,1" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Headline}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Click="ShowCautionPanelButton_Click"
                            Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" VerticalAlignment="Center"
                            ToolTip="Read the setup, controls, firewall, and account-risk information before using the mod">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource WarningBrush}" Margin="0,0,8,0">
                                <TextBlock Text="!" Foreground="#111510" FontSize="13" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Usage &amp; Risks" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="30,0,24,9">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SAFETY &amp; COMPATIBILITY" Style="{StaticResource MetaLabel}" />
                    <TextBlock Text="  ·  LIVE" Foreground="{StaticResource ReadyBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding LastChecked, StringFormat=  ·  Updated {0}}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="3,0,0,0" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="3" Margin="30,0,24,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CheckCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="94" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="31" Height="31" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Width="27" Height="27" CornerRadius="14" Background="{Binding StatusBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusGlyph}" Foreground="#111510" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Ready">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform X="-1" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Caution">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-1" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Game not running">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-2" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Mod not running">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-2" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusLabel}" Value="Blocked">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><TranslateTransform Y="-2" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <Ellipse Width="31" Height="31" Stroke="{StaticResource WarningBrush}" StrokeThickness="2"
                                                 StrokeDashArray="2,1.8" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:2.2" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding DetailToolTip}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" />
                                    <Button Grid.Column="3" Content="{Binding ActionLabel}" Command="{Binding DataContext.CheckActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" MinWidth="74" Height="34" VerticalAlignment="Center"
                                            IsEnabled="{Binding CanExecuteAction}"
                                            Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="30,14,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Launch without mod" Command="{Binding LaunchVanillaCommand}" Style="{StaticResource SecondaryButton}"
                        ToolTip="{Binding LaunchVanillaToolTip}" />
                <Button Grid.Column="2" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" MinWidth="244" Margin="10,0,0,0"
                        ToolTip="{Binding LaunchToolTip}">
                    <TextBlock Text="{Binding PrimaryActionLabel}" Foreground="#12160F" />
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Background="#171C17">
            <Grid.RowDefinitions>
                <RowDefinition Height="340" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ClipToBounds="True">
                <Image Source="Assets/nomad_2.png" Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <TranslateTransform Y="31" />
                    </Image.RenderTransform>
                </Image>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00171C17" Offset="0" />
                            <GradientStop Color="#00171C17" Offset="0.56" />
                            <GradientStop Color="#66171C17" Offset="0.78" />
                            <GradientStop Color="#FF171C17" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,0,20,16">
                <TextBlock Text="INSTALLATION" Style="{StaticResource MetaLabel}" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Storefront}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GamePath}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="CURRENT ACTIVITY" Style="{StaticResource MetaLabel}" Margin="0,0,0,7" />
                    <TextBlock Text="{Binding Activity}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="20,15,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="ACTIVITY LOG" Style="{StaticResource MetaLabel}" />
                    <Button Content="Clear" Command="{Binding ClearLogCommand}" Style="{StaticResource SecondaryButton}" Padding="8,3" HorizontalAlignment="Right" FontSize="10" />
                </Grid>
                <ScrollViewer x:Name="ActivityLogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ScrollViewer.Resources>
                        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Setter Property="Width" Value="10" />
                        </Style>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding ActivityLog}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,0,4,7" IsHitTestVisible="False" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="4" Margin="20,8,20,14">
                <Button Content="Remove launcher data…" Click="ShowCleanupPanelButton_Click" HorizontalAlignment="Center"
                        Padding="12,6" FontSize="10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RuntimeDetected}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="ToolTip" Value="Disable the mod in the running game before removing launcher data" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.ColumnSpan="2" Panel.ZIndex="90" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource TitleBarButton}" Click="MinimizeButton_Click"
                    ToolTip="Minimize" AutomationProperties.Name="Minimize">
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextBrush}" />
            </Button>
            <Button Style="{StaticResource TitleBarButton}" Click="CloseButton_Click"
                    ToolTip="Close" AutomationProperties.Name="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextBrush}" />
            </Button>
        </StackPanel>
            </Grid>

            <Grid x:Name="AntiCheatOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="760" Height="628" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SAYNOTOEAC MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="SayNoToEAC is required before Better Movement for KBM can be used" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="SayNoToEAC is a third-party mod by SunBeam."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="2" Background="#1A201A" BorderBrush="{StaticResource BlockedBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,0,0,8" x:Name="AntiCheatStatusBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BlockedBrush}"
                                        VerticalAlignment="Center" Margin="-10,0,0,0" x:Name="AntiCheatStatusCircle">
                                    <TextBlock x:Name="AntiCheatStatusGlyph" Text="×" Foreground="#111510" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-2" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="AntiCheatStatusHeading" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="AntiCheatStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,0,0,16" x:Name="AntiCheatBackupStatusBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource WarningBrush}"
                                        VerticalAlignment="Center" Margin="-10,0,0,0" x:Name="AntiCheatBackupStatusCircle">
                                    <TextBlock x:Name="AntiCheatBackupStatusGlyph" Text="!" Foreground="#111510" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="AntiCheatBackupStatusHeading" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="AntiCheatBackupStatusDetail" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="0,17,0,16">
                            <TextBlock Text="INSTALLATION INSTRUCTIONS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10" />

                            <TextBlock Text="1. Fully exit Ghost Recon Wildlands."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />

                            <TextBlock Text="2. Download SayNoToEAC from the original author thread or the alternative GamePressure mirror:"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <StackPanel Margin="18,7,0,0">
                                <TextBlock FontSize="12">
                                    <Hyperlink NavigateUri="https://fearlessrevolution.com/viewtopic.php?t=5980" RequestNavigate="AntiCheatLink_RequestNavigate"
                                               Foreground="{StaticResource AccentBrush}">Original author thread - Fearless Revolution</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Margin="0,6,0,0">
                                    <Hyperlink NavigateUri="https://www.gamepressure.com/download/tom-clancys-ghost-recon-wildlands-saynotoeac-mod/z113c5e"
                                               RequestNavigate="AntiCheatLink_RequestNavigate" Foreground="{StaticResource AccentBrush}">Alternative download mirror - GamePressure</Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="3. Open the game's EasyAntiCheat folder by clicking the 'Open EasyAntiCheat folder' button below. Rename EasyAntiCheat_x86.dll and EasyAntiCheat_x64.dll by adding .BAK to each filename. Make sure to keep these files so you may restore the original Ubisoft DLLs without having to validate the entire game installation."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />
                            <Button Content="Open EasyAntiCheat folder" Click="OpenAntiCheatFolderButton_Click" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Margin="18,8,0,0" />

                            <TextBlock Text="4. Extract the two replacement DLLs from the downloaded archive into that EasyAntiCheat folder."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />

                            <TextBlock Text="5. The two live checks below should now turn green. If so, SayNoToEAC has been installed, you may now close this panel."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,13,0,0" />
                        </StackPanel>

                        <Button Grid.Row="5" Click="CloseAntiCheatPanelButton_Click" Style="{StaticResource PrimaryButton}"
                                MinWidth="92" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <TextBlock Text="Close" Foreground="#12160F" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="SaveBackupOverlay" Grid.RowSpan="2" Panel.ZIndex="105" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="950" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="SAVE BACKUP MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="SavePanelHeading" Text="Detected save games" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Text="One active save location is selected automatically for each detected Steam or Ubisoft Connect installation." /><LineBreak />
                                <Run Text="Add redirected or custom locations below; every listed source keeps an independent backup identity and history." />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Exit Ghost Recon Wildlands before creating a backup. 'Back up' buttons are disabled while the game is running."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,16,0,14" />

                        <ListBox x:Name="SaveLocationsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="SaveLocationsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="#192019" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="12,9">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ReadyBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#232C23" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="225" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel ToolTip="{Binding SaveFilesPath}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="  ·  Auto-detected" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                                           VerticalAlignment="Center" Visibility="{Binding IsAutomatic, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                   TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="8,0,14,0" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="Back up" Tag="{Binding}" Click="BackUpSaveLocationButton_Click"
                                                    IsEnabled="{Binding CanBackUp}" ToolTip="{Binding BackUpToolTip}"
                                                    Style="{StaticResource SecondaryButton}" MinWidth="72" />
                                            <Button Content="Open saves" Tag="{Binding}" Click="OpenSaveLocationButton_Click"
                                                    ToolTip="Opens this live save location in File Explorer."
                                                    Style="{StaticResource SecondaryButton}" MinWidth="86" Margin="7,0,0,0" />
                                            <Button Content="Open backups" Tag="{Binding}" Click="OpenSaveBackupButton_Click"
                                                    IsEnabled="{Binding HasBackup}"
                                                    ToolTip="Opens the newest timestamped backup for this save location in File Explorer. Older backups are one folder above."
                                                    Style="{StaticResource SecondaryButton}" MinWidth="98" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="SavePanelStatus" Grid.Row="3" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />

                        <Grid x:Name="SavePanelActions" Grid.Row="4" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Add custom location…" Click="AddSaveLocationButton_Click" Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="RemoveSaveLocationButton" Grid.Column="1" Content="Remove selected" Click="RemoveSaveLocationButton_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="9,0,0,0" IsEnabled="False" />
                            <Button Grid.Column="3" Click="CloseSavePanelButton_Click" Style="{StaticResource PrimaryButton}"
                                    MinWidth="92" Margin="9,0,0,0">
                                <TextBlock Text="Close" Foreground="#12160F" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CleanupOverlay" Grid.RowSpan="2" Panel.ZIndex="108" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="650" Height="425" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="REMOVE LAUNCHER DATA" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Completely remove data created by Better Movement for KBM?" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="This action cannot be undone. Administrator approval may be requested to remove firewall rules. This action will close the launcher, then you should manually delete the portable .exe and any dedicated folder for it afterward."
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,17,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="-10,0,0,0">
                                    <TextBlock Text="!" Foreground="#111510" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Review what will and will not be removed before continuing:"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="WILL BE REMOVED" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="• Ghost Recon Wildlands and Ubisoft Connect firewall rules, if present."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Text="• Backed up saves created by this mod." Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Text="• Other launcher-created preferences, such as the last saved window position."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="WILL NOT BE TOUCHED" Foreground="{StaticResource ReadyBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock Text="• SayNoToEAC files or renamed EAC files." Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,7" />
                                <TextBlock Text="• Game saves in normal or custom save-game directories."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConfirmCleanupButton" Grid.Column="0"
                                    Click="ShowFinalCleanupConfirmationButton_Click" Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="Remove launcher data" Foreground="#12100F" />
                            </Button>
                            <TextBlock x:Name="CleanupPanelStatus" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="15,0,15,0" />
                            <Button x:Name="CancelCleanupButton" Grid.Column="2" Content="Go back" Click="CloseCleanupPanelButton_Click"
                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CleanupFinalOverlay" Grid.RowSpan="2" Panel.ZIndex="109" Background="#B8000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="450" Height="225" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#8E4844" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ARE YOU SURE?" Foreground="#DD746D" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Remove all launcher-created data?" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="This permanently removes the backups and firewall rules listed in the previous panel, then closes the launcher. This cannot be undone."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FinalCleanupYesButton" Grid.Column="0" Content="Yes"
                                    Click="FinalCleanupYesButton_Click" Style="{StaticResource DangerButton}"
                                    MinWidth="88" HorizontalAlignment="Left" />
                            <Button x:Name="FinalCleanupNoButton" Grid.Column="2" Content="No"
                                    Click="FinalCleanupNoButton_Click" Style="{StaticResource SecondaryButton}"
                                    MinWidth="88" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="CautionOverlay" Grid.RowSpan="2" Panel.ZIndex="110" Background="#A6000000"
                  Visibility="Collapsed" Focusable="True">
                <Border Width="1020" Height="744" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1" CornerRadius="0">
                    <Grid Margin="28,24,28,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="#1A201A" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="14,11" Margin="0,0,0,17">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="-11,0,0,0">
                                    <TextBlock Text="!" Foreground="#111510" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.RenderTransform><TranslateTransform Y="-1" /></TextBlock.RenderTransform>
                                    </TextBlock>
                                </Border>
                                <TextBlock Grid.Column="1" Text="CAUTION: This mod modifies the running Ghost Recon Wildlands process. Ubisoft or its anti-cheat systems may treat this as prohibited activity. Possible consequences include detection, crashes, corrupted saves, account suspension, or a permanent ban. No launcher check, firewall rule, offline procedure, or anti-cheat replacement can guarantee account safety."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Justify" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="WHAT DOES THIS MOD DO?" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                                <TextBlock Text="Better Movement for KBM adds granular movement-speed control for mouse-and-keyboard players. Scrolling the mouse wheel while moving adjusts your movement speed, similar to the analogue control previously available only with a gamepad. Aim-Down-Sight movement speeds are also adjusted to better match their non-ADS equivalents, while retaining mouse-wheel speed control when aiming."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,15" />

                                <TextBlock Text="USAGE" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />

                                <TextBlock Text="First launch and firewall setup" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Before the first modded session, launch the selected game installation normally while online and with both optional firewall blocks uninstalled. Reach the main menu, then exit Ghost Recon Wildlands and Ubisoft Connect before installing the blocks. If the game later reports an activation or startup error, uninstall both blocks and repeat this normal online launch once before reinstalling them. This may be required by any game installation, even if it previously launched successfully while blocked. If you cannot make the game start with the Firewall Blocks installed, you may safely install them after the game has been launched and is running."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,10" />

                                <TextBlock Text="Mouse-wheel control conflict" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="In the in-game control settings, reassign Mouse Wheel Up and Mouse Wheel Down weapon switching to other keys before using the mod. The game can still receive its own mouse-wheel input while the mod uses the wheel for movement speed. Keys 1, 2, and 3 remain available for direct weapon selection."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,10" />

                                <TextBlock Text="Using Better Movement for KBM" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Resolve all red blocked items and create a current save backup. It is also strongly recommended to resolve any remaining Caution items. Then use the adaptive green button to launch with Better Movement for KBM, enable it in an already running game, disable it while active, or cancel a pending launch. Keep the launcher open in the background while playing. Scroll while moving to adjust speed; the normal walk/jog toggle remains available, and sprinting restores full jogging speed."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" Margin="0,0,0,2" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CAUTIONS" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" />
                                <TextBlock Text="Better Movement for KBM is an unofficial mod and is used entirely at your own risk. Offline precautions can reduce exposure, but cannot make process modification risk-free."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,13" />
                                <TextBlock Text="Your responsibility" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Use the mod only in offline single-player, NEVER in co-op or Ghost War. Review the cautions on the main panel before starting the game together with the mod. Any enforcement action, data loss, crash, or other consequence remains your responsibility."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,13" />

                                <TextBlock Text="Windows Firewall blocks" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="The optional Windows Firewall blocks can help prevent an offline modding session from communicating through Ghost Recon Wildlands or Ubisoft Connect. They do not guarantee account safety."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,13" />

                                <TextBlock Text="Save backup" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Use the Save backup function to keep a current, edition-specific backup before using the mod. This provides a recovery point if a save is damaged, replaced, or unexpectedly synchronized. Steam, Ubisoft Connect, and custom-location progress can be stored separately and simultaneously."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,13" />

                                <TextBlock Text="Game compatibility" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="An untested game executable may still work because the runtime verifies every required instruction before writing. A compatibility caution means the executable has not yet been confirmed compatible with the current game version, but it may (or may not) still work."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,3,0,13" />

                                <TextBlock Text="Red blocked items, such as no detected SayNoToEAC installation, prevent the mod from working entirely."
                                           Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Justify" VerticalAlignment="Center" Margin="0,0,22,0">
                                <Run Text="Disclaimer: Better Movement for KBM is used entirely at your own risk." /><LineBreak />
                                <Run Text="Codex and Darojax accept no responsibility for account sanctions, loss of access, corrupted or lost data, crashes, or any other consequences resulting from its use." />
                            </TextBlock>
                            <Button Grid.Column="1" Click="CloseCautionPanelButton_Click" Style="{StaticResource PrimaryButton}"
                                    MinWidth="92" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <TextBlock Text="Close" Foreground="#12160F" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
