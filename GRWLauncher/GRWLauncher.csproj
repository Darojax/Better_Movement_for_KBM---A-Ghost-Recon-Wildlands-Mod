<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Better Movement for KBM - GRW</AssemblyName>
    <RootNamespace>GRWBetterMovementLauncher</RootNamespace>
    <AssemblyTitle>Better Movement for KBM - GRW</AssemblyTitle>
    <Product>Better Movement for KBM - GRW</Product>
    <Description>Better Movement for KBM - GRW</Description>
    <ApplicationIcon>..\assets\icons\grw.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\images\nomad_2.png" Link="Assets\nomad_2.png" />
    <Resource Include="..\assets\images\better_movement_for_kbm_logo_small_and_trimmed.png" Link="Assets\better_movement_for_kbm_logo_small_and_trimmed.png" />
    <Resource Include="..\assets\icons\grw.ico" Link="Assets\grw.ico" />
    <ProjectReference Include="..\GRWMovementRuntime\GRWMovementRuntime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyMovementRuntime" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <RuntimeFiles Include="..\GRWMovementRuntime\bin\$(Configuration)\net8.0-windows\GRWAnalogueMovement*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Runtime" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(OutDir)Runtime" SkipUnchangedFiles="true" />
  </Target>
</Project>
