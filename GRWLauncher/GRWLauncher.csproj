<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>GRWBetterMovementLauncher</AssemblyName>
    <RootNamespace>GRWBetterMovementLauncher</RootNamespace>
    <ApplicationIcon>..\assets\icons\grw.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\images\nomad_1.png" Link="Assets\nomad_1.png" />
    <Resource Include="..\assets\icons\grw.ico" Link="Assets\grw.ico" />
    <ProjectReference Include="..\GRWMovementRuntime\GRWMovementRuntime.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyMovementRuntime" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <RuntimeFiles Include="..\GRWMovementRuntime\bin\$(Configuration)\net8.0-windows\GRWAnalogueMovement*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Runtime" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(OutDir)Runtime" SkipUnchangedFiles="true" />
  </Target>
</Project>
