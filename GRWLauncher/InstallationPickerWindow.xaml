<Window x:Class="GRWBetterMovementLauncher.InstallationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Ghost Recon Wildlands installation"
        Icon="Assets/grw.ico"
        Width="680" Height="410"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="#465246" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="31" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#111510" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/grw.ico" Width="16" Height="16" Margin="10,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Choose Ghost Recon Wildlands installation" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="SELECT AN INSTALLATION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Detected Steam and Ubisoft Connect copies are listed below. Your choice is remembered."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>

                <ListBox x:Name="InstallationList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         SelectionChanged="InstallationList_SelectionChanged" MouseDoubleClick="InstallationList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="#1A201A" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="14,11" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#252E25" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#313C2B" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Storefront}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Directory}" Foreground="{StaticResource MutedTextBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Browse for another installation..." Click="BrowseButton_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="2" Content="Cancel" Click="CancelButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button x:Name="UseSelectedButton" Grid.Column="3" Click="UseSelectedButton_Click"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False">
                        <TextBlock Text="Use selected installation" Foreground="#12160F" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
